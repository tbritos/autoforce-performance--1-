DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PORT=5000
CORS_ORIGIN=https://app.seu-dominio.com
NODE_ENV=production
APP_URL=https://seu-dominio.com
FRONTEND_URL=https://app.seu-dominio.com
INTERNAL_API_KEY=gere_um_token_forte_para_integracoes
AUTH_SESSION_SECRET=gere_um_segredo_forte_para_sessoes
# Opcional/legado: JWT_SECRET tambem funciona se AUTH_SESSION_SECRET nao existir.
# JWT_SECRET=gere_um_segredo_forte_para_sessoes
AUTH_SESSION_EXPIRES_IN=30d
ENCRYPTION_KEY=gere_64_caracteres_hexadecimais

GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_ALLOWED_DOMAIN=autoforce.com

RD_STATION_CLIENT_ID=seu_rd_client_id
RD_STATION_CLIENT_SECRET=seu_rd_client_secret
RD_STATION_REFRESH_TOKEN=seu_rd_refresh_token
RD_STATION_WORKSPACE_ID=seu_rd_workspace_id
LEADS_WEBHOOK_TOKEN=seu_token_secreto_do_webhook

GEMINI_API_KEY=sua_gemini_api_key
# O bloco IA permite escolher provider/model na interface.
# Opcional: defaults usados quando o bloco nao definir.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

META_ACCESS_TOKEN=seu_meta_access_token
META_AD_ACCOUNT_ID=act_1234567890
META_APP_ID=seu_meta_app_id
META_APP_SECRET=seu_meta_app_secret

GA4_PROPERTY_ID=123456789
GA4_PROPERTY_IDS=123456789,987654321
LP_HOSTNAMES=lp.autodromo.com.br,site.autoforce.com,blog.autoforce.com
GA4_CREDENTIALS_PATH=/path/para/ga4-credentials.json
GA4_CREDENTIALS_JSON=

GOOGLE_ADS_DEVELOPER_TOKEN=seu_google_ads_developer_token
GOOGLE_ADS_CUSTOMER_ID=1234567890

GOOGLE_CALENDAR_ID=marketing@autoforce.com
GOOGLE_CALENDAR_CREDENTIALS_PATH=/path/para/google-calendar-credentials.json
GOOGLE_CALENDAR_CREDENTIALS_JSON=
CLOSER_EMAILS=closer1@autoforce.com,closer2@autoforce.com
# Opcional: configuracao completa dos vendedores/agendas.
# Formato simples em CLOSER_EMAILS:
# CLOSER_EMAILS=Nome Vendedor <vendedor@empresa.com>,Outro|outro@empresa.com|calendar-id@empresa.com|9|18
# Formato JSON avancado:
# CLOSERS_CONFIG=[{"name":"Tallys","email":"tallys@empresa.com","calendarId":"tallys@empresa.com","workStartHour":9,"workEndHour":18,"active":true}]
MEETING_TIMEZONE=America/Sao_Paulo
MEETING_WORK_START_HOUR=9
MEETING_WORK_END_HOUR=18
MEETING_SLOT_DURATION_MIN=30
MEETING_DAYS_AHEAD=5
MEETING_MAX_SLOTS=6

PIPEDRIVE_CLIENT_ID=seu_pipedrive_client_id
PIPEDRIVE_CLIENT_SECRET=seu_pipedrive_client_secret
PIPEDRIVE_API_TOKEN=seu_pipedrive_api_token
PIPEDRIVE_DOMAIN=suaempresa.pipedrive.com
