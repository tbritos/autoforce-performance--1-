// AutoForce Marketing Hub — Prisma Schema
// Synchronized with migration: 20260523100000_lead_foundation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTENTICAÇÃO & USUÁRIOS
// ============================================================

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  avatar      String?
  role        String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leadStatusChanges LeadStatusHistory[]
}

// ============================================================
// LEADS (entidade central — email é a chave natural)
// ============================================================

enum LeadStatus {
  LEAD
  MQL
  SQL
  SCHEDULED
  DEMO
  PROPOSAL
  OPPORTUNITY
  CLIENT
  LOST
  DISQUALIFIED
}

model Lead {
  id    String @id @default(uuid())
  email String @unique

  name     String?
  phone    String?
  company  String?
  jobTitle String?
  city     String?
  state    String?

  status LeadStatus @default(LEAD)

  // First-touch attribution — set on first conversion, never changed
  firstSource      String?
  firstMedium      String?
  firstCampaign    String?
  firstLandingPage String?

  score Int     @default(0)
  isHot Boolean @default(false)

  tags       String[]
  notes      String?  @db.Text
  assignedTo String?

  // AI agent state
  aiProcessing   Boolean   @default(false)
  aiProcessingAt DateTime?
  aiHandoff      Boolean   @default(false)

  // Pipedrive integration
  pipedrivePersonId String?
  pipedriveDealId   String?

  // Custom fields — schema defined in LeadCustomFieldDef
  customFields Json?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  qualifiedAt DateTime?
  convertedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  conversions      LeadConversion[]
  statusHistory    LeadStatusHistory[]
  revenueEntries   RevenueEntry[]
  pipedriveEvents  PipedriveDealEvent[]
  aiMemories       AIConversationMemory[]
  aiInteractions   AIInteractionLog[]
  emailsSent       EmailSent[]

  @@index([status])
  @@index([firstSource])
  @@index([isHot])
  @@index([score])
  @@index([assignedTo])
  @@index([lastSeenAt])
  @@index([firstSeenAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([pipedrivePersonId])
  @@index([aiProcessing])
  @@index([aiHandoff])
}

model LeadConversion {
  id        String @id @default(uuid())
  leadEmail String
  lead      Lead   @relation(fields: [leadEmail], references: [email])

  source     String
  externalId String?

  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  campaignName String?

  formName    String?
  landingPage String?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?

  rawData     Json
  convertedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([externalId, source])
  @@index([leadEmail])
  @@index([source])
  @@index([campaignId])
  @@index([convertedAt])
  @@index([utmCampaign])
  @@index([utmSource])
}

model LeadStatusHistory {
  id         String     @id @default(uuid())
  leadEmail  String
  lead       Lead       @relation(fields: [leadEmail], references: [email])
  fromStatus LeadStatus?
  toStatus   LeadStatus
  changedBy  String?
  user       User?      @relation(fields: [changedBy], references: [email])
  reason     String?
  changedAt  DateTime   @default(now())

  @@index([leadEmail])
  @@index([changedAt])
}

// ============================================================
// CAMPOS CUSTOMIZADOS DE LEAD
// Define quais campos extras existem e como renderizá-los na UI.
// Valores ficam em Lead.customFields (JSON).
// fieldType: "text" | "number" | "boolean" | "date" | "select" | "url"
// ============================================================

model LeadCustomFieldDef {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  fieldType   String   @default("text")
  options     String[] @default([])
  placeholder String?
  required    Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  sourceHint  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model LeadClassificationRule {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)
  priority    Int     @default(100)
  trigger     String  @default("lead_updated")

  conditions Json @default("[]")
  actions    Json @default("[]")

  lastRunAt DateTime?
  runCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions LeadClassificationRuleExecution[]

  @@index([isActive])
  @@index([priority])
  @@index([trigger])
  @@index([createdAt])
}

model LeadClassificationRuleExecution {
  id        String @id @default(uuid())
  ruleId    String
  rule      LeadClassificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  leadEmail String
  matched   Boolean
  actionsApplied Json @default("[]")
  error     String? @db.Text
  context   Json?
  createdAt DateTime @default(now())

  @@index([ruleId])
  @@index([leadEmail])
  @@index([matched])
  @@index([createdAt])
}

model AutomationJourney {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  status      String  @default("DRAFT")

  nodes Json @default("[]")
  edges Json @default("[]")

  triggerType String?
  isActive    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions AutomationExecution[]
  aiInteractions AIInteractionLog[]

  @@index([status])
  @@index([isActive])
  @@index([createdAt])
}

model AutomationExecution {
  id        String @id @default(uuid())
  journeyId String
  journey   AutomationJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  leadEmail String

  status        String    @default("running") // 'running' | 'waiting' | 'completed' | 'failed'
  currentNodeId String?
  resumeAt      DateTime?

  log   Json    @default("[]")
  error String? @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([journeyId])
  @@index([leadEmail])
  @@index([resumeAt])
  @@index([startedAt])
}

// ============================================================
// AGENTES IA
// Configuracao persistente do agente, base de conhecimento,
// memoria por lead e log auditavel de cada decisao.
// ============================================================

model AIAgent {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text
  isActive    Boolean @default(true)

  objective               String  @db.Text
  companyContext          String  @db.Text
  salesContext            String  @db.Text
  icp                     Json    @default("{}")
  qualificationCriteria   Json    @default("{}")
  disqualificationCriteria Json   @default("{}")
  toneOfVoice             String[] @default([])
  safetyRules             String[] @default([])
  discoveryQuestions      String[] @default([])
  handoffRules            Json     @default("{}")
  outputSchema            Json     @default("{}")

  defaultProvider String?
  defaultModel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeItems AIKnowledgeItem[]
  memories       AIConversationMemory[]
  interactions   AIInteractionLog[]

  @@index([isActive])
  @@index([createdAt])
}

model AIKnowledgeItem {
  id      String  @id @default(uuid())
  agentId String?
  agent   AIAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  title    String
  category String
  content  String @db.Text
  tags     String[] @default([])
  priority Int      @default(100)
  isActive Boolean  @default(true)

  sourceUrl String?
  metadata  Json?   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([category])
  @@index([isActive])
  @@index([priority])
  @@index([createdAt])
}

model AIConversationMemory {
  id        String @id @default(uuid())
  agentId   String
  agent     AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadEmail String
  lead      Lead    @relation(fields: [leadEmail], references: [email], onDelete: Cascade)

  channel String @default("whatsapp")

  summary             String? @db.Text
  knownFacts          Json    @default("{}")
  pains               String[] @default([])
  objections          String[] @default([])
  interests           String[] @default([])
  lastIntent          String?
  lastConversationState String?
  nextBestAction      String? @db.Text
  openQuestions       String[] @default([])

  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, leadEmail, channel])
  @@index([leadEmail])
  @@index([agentId])
  @@index([channel])
  @@index([updatedAt])
}

model AIInteractionLog {
  id      String @id @default(uuid())
  agentId String?
  agent   AIAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  leadEmail String
  lead      Lead @relation(fields: [leadEmail], references: [email], onDelete: Cascade)

  journeyId String?
  journey   AutomationJourney? @relation(fields: [journeyId], references: [id], onDelete: SetNull)

  executionId String?
  nodeId      String?
  channel     String @default("whatsapp")

  provider String
  model    String

  promptSnapshot Json
  response        Json
  decision        String?
  confidence      Float?
  recommendedActions Json @default("[]")
  error           String? @db.Text

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([leadEmail])
  @@index([journeyId])
  @@index([executionId])
  @@index([decision])
  @@index([createdAt])
}

model WhatsAppMessage {
  id String @id @default(uuid())

  leadId    String?
  leadEmail String?
  phone     String

  direction String // outbound | inbound
  type      String @default("text") // template | text | button | status
  status    String @default("received") // sent | delivered | read | failed | received

  messageId           String? @unique
  repliedToMessageId  String?
  automationJourneyId String?
  automationExecutionId String?

  templateName String?
  text         String? @db.Text
  payload      Json    @default("{}")

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  receivedAt  DateTime?
  failedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([leadEmail])
  @@index([phone])
  @@index([messageId])
  @@index([automationJourneyId])
  @@index([automationExecutionId])
  @@index([createdAt])
}

// ============================================================
// CONEXÕES DE PLATAFORMAS
// ============================================================

enum Platform {
  META_ADS
  GOOGLE_ADS
  GOOGLE_ANALYTICS
  RD_STATION
  GOOGLE_CALENDAR
  PIPEDRIVE
  CLARITY
  WHATSAPP
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  EXPIRED
}

model PlatformConnection {
  id       String           @id @default(uuid())
  platform Platform         @unique
  status   ConnectionStatus @default(DISCONNECTED)

  accountId   String?
  accountName String?
  extraIds    String[]

  // AES-256 encrypted by service layer — never plain text
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  tokenExpiry  DateTime?

  metadata Json?

  lastSyncAt     DateTime?
  lastSyncStatus String?
  lastSyncError  String?   @db.Text
  syncCount      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns      Campaign[]
  emailCampaigns EmailCampaign[]
  syncLogs       SyncLog[]
}

// ============================================================
// CAMPANHAS
// ============================================================

model Campaign {
  id       String @id @default(cuid())
  name     String
  platform String
  status   String

  objective   String?
  budget      Float    @default(0)
  dailyBudget Float?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date

  externalId           String?
  platformConnectionId String?
  platformConnection   PlatformConnection? @relation(fields: [platformConnectionId], references: [id])

  kpi   String?
  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  metrics         CampaignMetrics[]
  leadConversions LeadConversion[]
  utmLinks        UTMLink[]
  assetItems      AssetItem[]

  @@index([platform])
  @@index([status])
  @@index([externalId])
  @@index([platformConnectionId])
  @@index([startDate])
  @@index([deletedAt])
}

model CampaignMetrics {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  date       DateTime @db.Date

  impressions Int   @default(0)
  reach       Int   @default(0)
  clicks      Int   @default(0)
  ctr         Float @default(0)

  spend Float @default(0)
  cpc   Float @default(0)
  cpm   Float @default(0)
  cpl   Float @default(0)

  leads           Int   @default(0)
  conversions     Int   @default(0)
  conversionValue Float @default(0)
  roas            Float @default(0)

  videoViews    Int?
  videoWatchPct Float?

  createdAt DateTime @default(now())

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
}

// ============================================================
// UTM LINKS
// ============================================================

model UTMLink {
  id        String @id @default(uuid())
  createdBy String

  title          String?
  destinationUrl String
  fullUrl        String  @db.Text
  shortUrl       String?
  shortCode      String? @unique

  utmSource   String
  utmMedium   String
  utmCampaign String
  utmContent  String?
  utmTerm     String?

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  clicks       Int     @default(0)
  isTemplate   Boolean @default(false)
  templateName String?
  isFavorite   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdBy])
  @@index([utmCampaign])
  @@index([campaignId])
  @@index([isTemplate])
  @@index([isFavorite])
  @@index([createdAt])
  @@index([deletedAt])
}

model UTMDestination {
  id        String   @id @default(uuid())
  label     String
  url       String
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdBy])
  @@index([createdAt])
}

// ============================================================
// RECEITA & GANHOS
// ============================================================

model RevenueEntry {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  businessName    String
  leadEmail       String?
  lead            Lead?    @relation(fields: [leadEmail], references: [email])
  setupValue      Float
  mrrValue        Float
  origin          String
  originType      String   @default("INBOUND")
  product         String[]
  closedBy        String?  // vendedor
  whyBought       String[] // Porque Comprou?
  currentSupplier String[] // Fornecedor atual
  dealUrl         String?  // link do card no Pipedrive
  contractLink    String?  // Link do Contrato
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([leadEmail])
  @@index([originType])
  @@index([closedBy])
}

// ============================================================
// OKRs
// ============================================================

model OKR {
  id        String   @id @default(cuid())
  quarter   String
  year      Int?
  objective String
  progress  Int      @default(0)
  keyResults Json
  status    String   @default("ON_TRACK")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
  @@index([quarter])
}

// ============================================================
// TIME
// ============================================================

model TeamMember {
  id             String   @id @default(cuid())
  name           String
  email          String?  @unique
  role           String
  avatar         String?
  status         String
  lastActive     String
  leadsGenerated Int      @default(0)
  salesClosed    Int      @default(0)
  goalProgress   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// LANDING PAGES (GA4)
// ============================================================

model LandingPage {
  id                  String    @id @default(cuid())
  name                String
  path                String    @unique
  views               Int       @default(0)
  users               Int       @default(0)
  sessions            Int       @default(0)
  conversions         Int       @default(0)
  conversionRate      Float     @default(0)
  avgEngagementTime   String
  avgSessionDuration  Float     @default(0)
  bounceRate          Float     @default(0)
  totalClicks         Int       @default(0)
  source              String    @default("google_analytics")
  lastSyncAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([conversions])
  @@index([lastSyncAt])
}

// ============================================================
// CALENDÁRIO
// ============================================================

model CampaignEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  color       String
  type        String   @default("CAMPAIGN")
  notes       String?
  campaignId  String?
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([type])
  @@index([campaignId])
}

// ============================================================
// LEADS DIÁRIOS (entrada manual — funil agregado)
// ============================================================

model DailyLead {
  id             String   @id @default(uuid())
  date           DateTime @unique
  leads          Int      @default(0)
  mql            Int      @default(0)
  sql            Int      @default(0)
  sales          Int      @default(0)
  conversionRate Float    @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}

// ============================================================
// ASSETS / CRIATIVOS
// ============================================================

model AssetItem {
  id         String   @id @default(cuid())
  name       String
  category   String
  link       String
  notes      String?
  tags       String[] @default([])
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  versions AssetVersion[]

  @@index([category])
  @@index([campaignId])
  @@index([deletedAt])
}

model AssetVersion {
  id        String    @id @default(cuid())
  assetId   String
  asset     AssetItem @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label     String
  link      String
  notes     String?
  createdAt DateTime  @default(now())

  @@index([assetId])
}

// ============================================================
// EMAILS ENVIADOS (via Resend)
// ============================================================

model EmailSent {
  id            String   @id @default(cuid())
  leadEmail     String
  lead          Lead     @relation(fields: [leadEmail], references: [email])
  resendId      String?  @unique
  subject       String
  fromName      String?
  fromEmail     String?
  toEmail       String
  status        String   @default("sent")
  openedAt      DateTime?
  clickedAt     DateTime?
  bouncedAt     DateTime?
  complainedAt  DateTime?
  automationExecutionId String?
  automationNodeId      String?
  sentAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadEmail])
  @@index([status])
  @@index([sentAt])
}

// ============================================================
// E-MAIL MARKETING
// ============================================================

model EmailCampaign {
  id                   String              @id @default(cuid())
  externalId           String?
  source               String              @default("manual")
  platformConnectionId String?
  platformConnection   PlatformConnection? @relation(fields: [platformConnectionId], references: [id])
  name                 String
  date                 DateTime            @db.Date
  sends                Int                 @default(0)
  opens                Int                 @default(0)
  clicks               Int                 @default(0)
  conversions          Int                 @default(0)
  bounce               Int                 @default(0)
  unsubscribes         Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([externalId, source])
  @@index([date])
  @@index([source])
}

model WorkflowEmailStat {
  id               String   @id @default(cuid())
  externalId       String
  workflowId       String?
  workflowName     String
  emailName        String
  delivered        Int      @default(0)
  opened           Int      @default(0)
  clicked          Int      @default(0)
  bounced          Int      @default(0)
  unsubscribed     Int      @default(0)
  deliveredRate    Float    @default(0)
  openedRate       Float    @default(0)
  clickedRate      Float    @default(0)
  spamRate         Float    @default(0)
  date             DateTime @db.Date
  source           String   @default("rd")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([externalId, source])
  @@index([workflowId])
  @@index([date])
}

// ============================================================
// SISTEMA: Logs e Webhooks
// ============================================================

model SyncLog {
  id                   String              @id @default(cuid())
  source               String
  platformConnectionId String?
  platformConnection   PlatformConnection? @relation(fields: [platformConnectionId], references: [id])
  status               String
  message              String?
  recordsProcessed     Int                 @default(0)
  startedAt            DateTime            @default(now())
  finishedAt           DateTime?

  @@index([source, startedAt])
  @@index([status])
  @@index([platformConnectionId])
}

model LeadWebhookSource {
  id            String   @id @default(uuid())
  publicId      String   @unique
  name          String
  type          String
  description   String?  @db.Text
  isActive      Boolean  @default(true)
  securityMode  String   @default("SECRET_URL")

  automaticTags String[] @default([])
  fieldMappings Json     @default("{}")

  defaultPersona  String?
  defaultPain     String?
  defaultSource   String?
  defaultCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs WebhookLog[]

  @@index([publicId])
  @@index([isActive])
  @@index([type])
  @@index([createdAt])
}

model WebhookLog {
  id          String             @id @default(uuid())
  source      String
  sourceId    String?
  sourceRef   LeadWebhookSource? @relation(fields: [sourceId], references: [id])
  payload     Json
  normalized  Json?
  result      Json?
  status      String
  leadEmail   String?
  error       String?            @db.Text
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@index([source])
  @@index([sourceId])
  @@index([status])
  @@index([receivedAt])
  @@index([leadEmail])
}

// ============================================================
// FUNIS DE CONVERSÃO
// Cada funil define um fluxo de rastreamento filtrado por parâmetros UTM.
// Os leads são correspondidos via campos de first-touch.
// ============================================================

model Funnel {
  id          String  @id @default(uuid())
  name        String
  description String?
  color       String  @default("#3b82f6")

  // UTM filter criteria — null = sem filtro (equivale a "todos")
  filterSource      String?
  filterMedium      String?
  filterCampaign    String?
  filterLandingPage String?

  // Tag-based membership + GA4 impression pages
  leadTags        String[] @default([])
  impressionPages String[] @default([])

  // Linked ad campaigns for spend attribution
  campaignIds     String[] @default([])

  // Stage configuration — array of { id, name, source, color }
  stagesConfig    Json?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([isActive])
}

// ============================================================
// PIPEDRIVE DEAL EVENTS — Histórico de movimentações de deals
// Alimentado por webhook em tempo real + sync como fallback.
// ============================================================

model PipedriveDealEvent {
  id            String   @id @default(cuid())
  dealId        String   // ID numérico do deal no Pipedrive (como string)
  leadEmail     String
  lead          Lead     @relation(fields: [leadEmail], references: [email])

  // Tipo do evento
  eventType     String   // 'created' | 'stage_changed' | 'value_changed' | 'won' | 'lost' | 'reopened'

  // Mudança de estágio
  fromStageId   Int?
  fromStageName String?
  toStageId     Int?
  toStageName   String?

  // Mudança de valor
  fromValue     Float?
  toValue       Float?

  // Snapshot do deal
  dealTitle     String?
  dealStatus    String   // 'open' | 'won' | 'lost'

  occurredAt    DateTime // quando aconteceu no Pipedrive (update_time)
  source        String   @default("sync") // 'webhook' | 'sync' | 'backfill'

  createdAt     DateTime @default(now())

  @@index([leadEmail])
  @@index([dealId])
  @@index([occurredAt])
}

